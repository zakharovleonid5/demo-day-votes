{
  "rewrites": [
    {
      "source": "/",
      "destination": "https://194-87-103-89.sslip.io/"
    },
    {
      "source": "/:path*",
      "destination": "https://194-87-103-89.sslip.io/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
